# Copy this file to ".env" and fill in your real keys.
# Get a free Groq API key at: https://console.groq.com/keys
# NEVER commit your real .env file — it is in .gitignore.

# ── Required ───────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── Optional (for Render deployment) ──────────────────────────────────────
# Set INDEX_DIR to use a smaller index (the backup) to stay within free-tier RAM:
# INDEX_DIR=index_store_backup_20261005_152032

# Comma-separated list of allowed frontend origins (Render backend → Vercel frontend):
# CORS_ORIGINS=https://your-app.vercel.app

# Minimum retrieval score (0-1) below which a "not found" response is returned.
# 0.54 was the best value on the 38-query eval (refuses 6 of 7 unanswerable, 0 wrongly refused).
MIN_RETRIEVAL_SCORE=0.54
# ── Security (see README "Security and limits") ───────────────────────────
# Protects upload, delete and feedback listing. If this is NOT set those routes
# are disabled (403). Use a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=change-me-to-a-long-random-value

# ── Refusal behaviour (see README "When the corpus does not cover a question") ──
# Optional second gate inside the ambiguous score band. Calibrate before enabling.
# RERANK_MIN_SCORE=0.0
# RERANK_GATE_BELOW=0.62
# Let the model write an UNGROUNDED, disclaimed general-law overview when nothing matches (default off).
# ALLOW_STATUTORY_FALLBACK=0

# Per-IP and global limits on every route that calls Groq.
# Groq limits are per ORGANIZATION: extra API keys from one account add no quota.
RATE_LIMIT_PER_MIN=6
RATE_LIMIT_PER_DAY=100
RATE_LIMIT_GLOBAL_PER_MIN=12
# RATE_LIMIT_ENABLED=0          # turn limiting off for local testing

# Number of trusted proxies in front of the app (Render = 1). 0 = ignore X-Forwarded-For.
TRUST_PROXY_HOPS=1

# Upload limits
MAX_UPLOAD_FILES=20
MAX_UPLOAD_MB=30

# Authentication: set a long random secret in production (e.g. 32+ random bytes)
AUTH_SECRET=replace-with-a-long-random-production-secret
# Optional: signed session lifetime; default is 7 days
AUTH_TOKEN_TTL_SECONDS=604800
# Optional SQLite location (default: users.db)
AUTH_DB_PATH=users.db
GROQ_ANALYSIS_MODEL=openai/gpt-oss-20b

# Free-tier Case Intelligence: compact context budget for one coordinated analysis
CASE_INTELLIGENCE_MAX_CHARS=12000
CASE_INTELLIGENCE_PER_MIN=2
CASE_INTELLIGENCE_PER_DAY=20

# ── Gemini provider routing ────────────────────────────────────────────────
# Optional but strongly recommended: independent citation verification,
# Case Intelligence extraction, and Moot Court judicial reasoning.
GEMINI_API_KEY=your_gemini_api_key_here
# Current stable model IDs (override only if you intentionally change models):
GEMINI_VERIFY_MODEL=gemini-2.0-flash-lite
GEMINI_EXTRACTION_MODEL=gemini-2.0-flash-lite
GEMINI_REASONING_MODEL=gemini-2.5-flash
# Central Groq model overrides used by llm_router.py
GROQ_PRIMARY_MODEL=qwen/qwen3.8-27b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_VERIFY_MODEL=openai/gpt-oss-20b
GROQ_SECONDARY_VERIFY_MODEL=openai/gpt-oss-120b

# Retrieval quality strategy
# improved = weighted hybrid candidate preservation + BM25 rescue + stable reranking
# legacy   = previous RRF + pure Cross-Encoder ordering
RAG_RETRIEVAL_STRATEGY=improved
RAG_BM25_RESCUE_DOCS=5
RAG_RERANK_STABILITY=0.25

# Optional page-level OCR fallback. Native text extraction always runs first.
OCR_ENABLED=true
OCR_MIN_CHARS=80
OCR_MIN_ALPHA_RATIO=0.45
OCR_DPI=220
OCR_LANG=eng

# ── Task-aware dual-provider routing ───────────────────────────────────────
# Gemini is primary for Moot Court, Case Intelligence and Issue Map.
# Groq is primary for shorter interactive generation; the other provider is fallback.
# These are output budgets, not context limits. Keep Groq <= your service-tier OTPM.
GROQ_MAX_OUTPUT_TOKENS=900
TOKENS_ADVOCATE=900
TOKENS_CITIZEN=750
TOKENS_GENERAL=900
TOKENS_MOOT=700
TOKENS_MOOT_SHORT=500
TOKENS_CASE_INTELLIGENCE=950
TOKENS_ISSUE_MAP=700
TOKENS_VERIFICATION=500

# ── Deployment modes ──────────────────────────────────────────────────────
# development: local research corpus can be enabled
# production: research corpus defaults OFF and developer tools default OFF
LEXAI_ENV=development
GLOBAL_JUDGMENT_CORPUS_ENABLED=true
ENABLE_DEVELOPER_TOOLS=true

# Persistent runtime storage. On Railway mount a volume at /data and use:
# LEXAI_DATA_ROOT=/data/lexai
LEXAI_DATA_ROOT=.
CASE_DB_PATH=cases.db
CASE_FILES_DIR=user_case_files
CASE_INDEX_DIR=user_case_indexes
# In production also point auth/feedback DBs to the persistent volume:
# AUTH_DB_PATH=/data/lexai/users.db
# CASE_DB_PATH=/data/lexai/cases.db
# CASE_FILES_DIR=/data/lexai/user_case_files
# CASE_INDEX_DIR=/data/lexai/user_case_indexes

# Production frontend origin, comma-separated. Example:
# CORS_ORIGINS=https://your-lexai.vercel.app

# ── Render Free demo profile ──────────────────────────────────────────────
# Keeps the 848-judgment research corpus and developer tools out of public deployment.
LEXAI_RENDER_FREE_MODE=false
LEXAI_LOW_MEMORY_MODE=false
# Recommended Render Free values:
# LEXAI_ENV=production
# LEXAI_RENDER_FREE_MODE=true
# LEXAI_LOW_MEMORY_MODE=true
# GLOBAL_JUDGMENT_CORPUS_ENABLED=false
# ENABLE_DEVELOPER_TOOLS=false
# MAX_UPLOAD_FILES=5
# MAX_UPLOAD_MB=8
# Note: Render Free local storage is ephemeral; private demo data can disappear after restart/redeploy.

# ── Persistence backend ────────────────────────────────────────────────────
# local = SQLite/local files (development)
# supabase = persistent PostgreSQL + private Storage (Render production)
LEXAI_STORAGE_BACKEND=local
SUPABASE_URL=https://rcxxoiabbeownibeorkm.supabase.co
SUPABASE_STORAGE_BUCKET=lexai-private
# Backend only. NEVER expose this as VITE_* or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Bounded feedback learning / contextual-bandit retrieval tuning
FEEDBACK_LEARNING_ENABLED=true
FEEDBACK_MIN_EVENTS=3
FEEDBACK_MAX_WEIGHT_DELTA=0.12
FEEDBACK_MAX_SOURCE_BONUS=0.0015
